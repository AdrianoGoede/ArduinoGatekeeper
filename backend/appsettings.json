{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AgkDatabase": "Host=agk_database;Database=postgres;Username=agk_backend;Password=1234;SslMode=VerifyFull;RootCertificate=certs/ca.crt;SslCertificate=certs/backend.crt;SslKey=certs/backend.key;"
  },
  "Ssl": {
    "CaCert": "/app/certs/ca.crt",
    "ServerCert": "/app/certs/backend.crt",
    "ServerKey": "/app/certs/backend.key"
  },
  "MqttBroker": {
    "Host": "agk_mqtt_broker",
    "Port": 8883,
    "ClientId": "agk_backend",
    "DeviceIdPrefix": "agk_door_",
    "ReconnectionDelay": 5,
    "AddUsersPageSize": 10,
    "Topics": {
      "DeviceStatus": "AGK/+/dev_status",
      "Scan": "AGK/+/scan",
      "AddUsers": "AGK/+/add_users",
      "RemoveUsers": "AGK/+/remove_users"
    }
  }
}
